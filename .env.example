# Copy this file to .env and fill in the real value. .env is gitignored and
# must never be committed.

# GitHub personal access token. Only needs public-repo read scope (no write,
# no admin) — used for repo-metadata reads, search discovery, and the
# stargazer-sampling backfill attempt (see 01-CONTEXT.md D-05/D-08a).
GITHUB_TOKEN=

# Anthropic API key for the enrichment LLM call (summarize + classify into
# one of the seven sections, D-01/D-03). Get one from the Anthropic Console
# under Settings -> API keys.
ANTHROPIC_API_KEY=

# TECHTREND_DISABLE_LLM=1  # set to skip enrichment LLM/summary calls

# Optional overrides for the enrichment provider/model/endpoint -- when set,
# each wins over the corresponding config/tracked.toml [tunables] value.
# TECHTREND_ENRICHMENT_PROVIDER=  # e.g. openai or anthropic
# TECHTREND_ENRICHMENT_BASE_URL=  # OpenAI-compatible endpoint, if provider=openai
# TECHTREND_ENRICHMENT_MODEL=  # e.g. glm-4.7-flash
